# Скопировать на сервере в /opt/colorbox/colorbox.env (вне git-репозитория — там секреты)
# и подставить реальные значения. Права на файл: chmod 600, владелец — пользователь colorbox.

DATABASE_URL=postgresql://colorbox:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/colorbox

# Хранение фото (storage.py). Не задавать STORAGE_BACKEND — фото остаются на локальном
# диске (static/uploads/), как раньше. STORAGE_BACKEND=s3 переключает на Yandex Object
# Storage — перед этим не забыть перенести уже существующие файлы
# (scripts/migrate_uploads_to_s3.py), иначе старые фото в архиве перестанут открываться.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY — статический ключ сервисного аккаунта с
# доступом к бакету (Yandex Cloud → IAM → сервисные аккаунты); их читает сам boto3,
# отдельных переменных под них в коде нет.
# STORAGE_BACKEND=s3
# S3_BUCKET=colorbox-lab-photos
# S3_ENDPOINT_URL=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY